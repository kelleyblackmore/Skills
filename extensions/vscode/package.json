{
  "name": "agent-skills",
  "displayName": "Agent Skills",
  "description": "Browse agent skills and add them to your project or user profile in one click.",
  "version": "0.1.0",
  "publisher": "kelleyblackmore",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kelleyblackmore/Skills.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.140.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "skills",
    "agent",
    "claude",
    "copilot",
    "cursor"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSkills",
          "title": "Agent Skills",
          "icon": "media/skills.svg"
        }
      ]
    },
    "views": {
      "agentSkills": [
        {
          "id": "agentSkills.list",
          "name": "Skills"
        }
      ]
    },
    "commands": [
      {
        "command": "agentSkills.refresh",
        "title": "Refresh",
        "category": "Skills",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSkills.addToProject",
        "title": "Add to Project",
        "category": "Skills",
        "icon": "$(add)"
      },
      {
        "command": "agentSkills.installForUser",
        "title": "Install for Me",
        "category": "Skills",
        "icon": "$(account)"
      },
      {
        "command": "agentSkills.openPage",
        "title": "Open Skill Page",
        "category": "Skills",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSkills.refresh",
          "when": "view == agentSkills.list",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentSkills.addToProject",
          "when": "view == agentSkills.list && viewItem =~ /^skill/",
          "group": "inline@1"
        },
        {
          "command": "agentSkills.installForUser",
          "when": "view == agentSkills.list && viewItem =~ /^skill/",
          "group": "inline@2"
        },
        {
          "command": "agentSkills.openPage",
          "when": "view == agentSkills.list && viewItem =~ /^skill/",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "agentSkills.openPage",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Skills",
      "properties": {
        "agentSkills.indexUrl": {
          "type": "string",
          "default": "https://kelleyblackmore.github.io/Skills/skills.json",
          "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?/)",
          "description": "URL of the skills.json index published by the skills site. Must be https, except http://localhost for previewing a locally built site."
        },
        "agentSkills.projectFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".claude/skills",
            ".github/skills"
          ],
          "description": "Folders inside the project that 'Add to Project' writes each skill into. .claude/skills is read by Claude Code, Cursor and Devin; .github/skills by VS Code Copilot."
        },
        "agentSkills.userFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/.claude/skills",
            "~/.agents/skills"
          ],
          "description": "Folders under your home directory that 'Install for Me' writes each skill into."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/**/*.test.js\"",
    "package": "npm run build && vsce package --no-dependencies --skip-license --out agent-skills.vsix",
    "vscode:prepublish": "npm run build",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@azure/msal-node": "7.1.1"
  },
  "//overrides": "@azure/msal-node 6.x has GHSA-xcx6-jx8p-x3h5; @azure/identity (via vsce) pins ^6. Only vsce publish --azure-credential uses it, which this repo does not call. Remove once @azure/identity accepts >=7.1.",
  "type": "module",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  }
}
